# Copy to .env.local (never commit .env.local).

# Password for the dashboard at /admin. Required in production.
# In development it defaults to "saintleon" if unset.
ADMIN_PASSWORD=

# Long random string used to sign login cookies (32+ characters). Required in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Where content is saved:
#   local    → JSON files in /content (default with `npm run dev`)
#   readonly → no saving (default in production, e.g. on Vercel)
# A database adapter can be added later in src/lib/cms/storage/.
# CMS_STORAGE=local
